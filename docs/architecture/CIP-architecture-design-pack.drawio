ainer (own code)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td bgcolor="#ffe6cc" style="border:1px solid #d79b00;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;Processing engine job (Flink / Spark / Airflow)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td bgcolor="#e1d5e7" style="border:1px solid #9673a6;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;Kafka cluster / topic (pill)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td bgcolor="#d5e8d4" style="border:1px solid #82b366;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;Datastore (cylinder)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px dashed #666666;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;External system (dashed)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="center"&gt;&amp;#9472;&amp;#9472;&amp;#9654;&lt;/td&gt;&lt;td&gt;Synchronous call / connection&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="center"&gt;&amp;#9480;&amp;#9480;&amp;#9654;&lt;/td&gt;&lt;td&gt;Asynchronous / event via Kafka&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;span style="font-size:10px;color:#555555"&gt;Arrow = direction of data flow&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="330" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d4" name="04 L2-C Stream &amp; Batch Processing"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2030" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4_1" value='&lt;b style="font-size:20px"&gt;L2-C - Container view: Stream &amp;amp; batch processing and serving stores&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;Lambda-lite (ADR-01): Flink = only real-time compute; Spark = batch only - shared definitions in cip-core - arrow = data flow&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="p4_2" value='&lt;b&gt;market.normalized.v1&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;from page 03&lt;/span&gt;' style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1a1a1a;rounded=1;arcSize=50;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="407" width="210" height="46" as="geometry"/></mxCell><mxCell id="p4_3" value='&lt;b&gt;candle-aggregator&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#444444"&gt;[Job: Flink 1.19 job, DataStream]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#222222"&gt;Dedupe -&amp;gt; event-time windows 1m..1d -&amp;gt; OHLCV + VWAP. Single owner of candles (ADR-02).&lt;/span&gt;' style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1a1a1a;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="300" y="225" width="240" height="90" as="geometry"/></mxCell><mxCell id="p4_4" value='&lt;b&gt;lake-archiver&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#444444"&gt;[Job: Flink 1.19 job, FileSink]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#222222"&gt;Normalized trades -&amp;gt; Parquet (zstd), hourly roll; exactly-once via checkpoints.&lt;/span&gt;' style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#1a1a1a;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="300" y="545" width="240" height="90" as="geometry"/></mxCell><mxCell id="p4_5" value='&lt;b&gt;market.candles.v1&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;key=symbol|tf - 12p - 7d&lt;/span&gt;' style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#1a1a1a;rounded=1;arcSize=50;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="247" width="210" height="46" 