n="top" style="word-wrap:break-word;"&gt;OrderEvent&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;paper-execution&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;portfolio-service, realtime-gateway&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;30 d&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;NEW -&amp;gt; FILLED / REJECTED / CANCELLED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;fills.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;account|symbol&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;6&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Fill&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;paper-execution&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;portfolio-service&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;30 d&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;fill_id unique&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;positions.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;account|symbol&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;6&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PositionSnapshot&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;portfolio-service&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;risk-analytics, realtime-gateway&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;30 d, compact+delete&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;latest per key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;risk.alerts.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;account&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;3&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;RiskAlert&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;risk-analytics&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;paper-execution (halt), realtime-gateway&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;30 d&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;severity, rule_id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;research.jobs.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;job_id&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;3&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;JobRequest&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;command-api, model-monitoring, airflow&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;backtesting, pairs-research, model-training (group per job type)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;7 d&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;KEDA ScaledJob trigger&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ops.commands.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;target&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;3&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Command&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;command-api, market-collector&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;historical-ingestor, dlq-replayer, strategy-engine&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;7 d&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;BackfillRequest, ReplayRequest, StrategyToggle&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="2000" height="400" as="geometry"/></mxCell><mxCell id="p6_3" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Conventions&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="9.1%"&gt;Item&lt;/td&gt;&lt;td valign="top" width="90.9%"&gt;Rule&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Naming&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;topic = &amp;lt;domain&amp;gt;.&amp;lt;entity&amp;gt;.v&amp;lt;N&amp;gt;; consumer group = cg.&amp;lt;service&amp;gt;[.&amp;lt;variant&amp;gt;]; one shared DLQ market.dlq.v1.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Producer&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;acks=all, enable.idempotence=true, compression=zstd, linger.ms=5, max.in.flight=5.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Consumer&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;enable.auto.commit=false; commit after sink success; isolation.level=read_committed for Flink-written topics; partition.assignment=cooperative-sticky; max.poll.interval=5 min.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Partitioning&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;key = symbol (per-symbol order). 12 partitions on hot topics (&amp;gt;= max consumers, x3 headroom for 100 symbols). Increase only with a planned re-key.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Replication&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;RF=3, min.insync.replicas=2, unclean.leader.election=false, rack-aware.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Headers&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;traceparent, schema_version, event_id, source, ingest_ts.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Wire format&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Confluent wire format (magic byte 0x00 + 4-byte schema ID) via cip-kafka; subject = &amp;lt;topic&amp;gt;-value; schemas registered by CI (ADR-13).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Timestamps&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;event_ts = exchange time (UTC, microseconds); ingest_ts = collector time; Kafka record timestamp = event_ts (CreateTime).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Late data&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Flink watermark = max out-of-orderness 2 s; allowedLateness 30 s; later -&amp;gt; market.late.v1 and corrected by Spark candle-backfill.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Failure policy&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Deserialization / validation failure -&amp;gt; DLQ immediately; transient error -&amp;gt; retry 3x (200 ms -&amp;gt; 5 s) then DLQ. No infinite retry.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="2000" height="261" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d7" name="07 Event &amp; API Contracts"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1221" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7_1" value='&lt;b style="font-size:20px"&gt;Event schemas &amp;amp; API contracts&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;Authoritative contract = schemas/avro/*.avsc, schemas/openapi/*.yaml, schemas/asyncapi/ws.yaml in the repo; this page is the readable summary&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="p7_2" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Avro event schemas&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="14.3%"&gt;Schema&lt;/td&gt;&lt;td valign="top" width="85.7%"&gt;Fields (name: type)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Envelope (all events)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;event_id string(UUIDv7); schema_version int; source string; symbol string; event_ts long(timestamp-micros); ingest_ts long; seq long (per source+symbol)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;RawFrame&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;envelope + channel string; payload bytes (original JSON); ingest_mode enum{live, backfill, replay}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;MarketTrade&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;envelope + trade_id string; price decimal(28,10); size decimal(28,10); side enum{BUY, SELL}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Candle&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;symbol; tf enum{1m,5m,15m,1h,1d}; open_ts; close_ts; o,h,l,c decimal; volume; vwap; trade_count int; buy_volume; is_final bool; updated_at&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;FeatureVector&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;symbol; tf; ts; feature_set_version string; features map&amp;lt;string,double&amp;gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Prediction&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;symbol; ts; model_name; model_version; horizon string; score double; label string?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Signal&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;signal_id (hash); strategy_id; strategy_version; symbol; side enum{LONG,SHORT,FLAT}; strength double[0..1]; bar_ts; reason string&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;OrderEvent / Fill&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;OrderEvent: order_id; signal_id; account_id; symbol; side; type enum{MARKET,LIMIT}; qty; limit_px?; status enum{NEW,FILLED,REJECTED,CANCELLED}; reject_reason?  |  Fill: fill_id; order_id; qty; px; fee; fee_ccy; ts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PositionSnapshot&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;account_id; symbol; qty; avg_px; mark_px; realized_pnl; unrealized_pnl; ts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;DeadLetter&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;original_payload bytes; error_code; error_msg; src_topic; src_partition; src_offset; failed_at; stage enum{validator, normalizer}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Evolution rules&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Add optional fields with defaults only; never rename or remove; add enum symbols at the end with a default; breaking change =&amp;gt; new topic .v2 + dual publish.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1900" height="282" as="geometry"/></mxCell><mxCell id="p7_3" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;REST API (OpenAPI 3.1) - via api-gateway&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="40.0%"&gt;Method + path&lt;/td&gt;&lt;td valign="top" width="13.3%"&gt;Service&lt;/td&gt;&lt;td valign="top" width="13.3%"&gt;Scope&lt;/td&gt;&lt;td valign="top" width="33.3%"&gt;Notes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;GET /v1/symbols&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;query-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market:read&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;list active symbols&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;GET /v1/candles?symbol&amp;amp;tf&amp;amp;from&amp;amp;to&amp;amp;limit&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;query-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market:read&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cursor pagination, max 5,000 rows; Cache-Control by tf&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;GET /v1/ticks?symbol&amp;amp;from&amp;amp;to&amp;amp;cursor&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;query-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market:read&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;max 10,000 rows per page&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;GET /v1/features/latest?symbol&amp;amp;tf&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;query-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market:read&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;from Redis feat:*&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;GET /v1/signals | /v1/orders | /v1/positions | /v1/pnl&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;query-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;trading:read&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;filters: account_id, strategy_id, from, to&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;GET /v1/backtests/{run_id} | /v1/jobs/{job_id}&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;query-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;trading:read&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;metrics + presigned artifact URL (MinIO)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;GET /v1/data-quality/incidents&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;query-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market:read&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;status, severity filters&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;POST /v1/backtests&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;command-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;research:write&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;202 {job_id}; header Idempotency-Key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;POST /v1/research/pairs&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;command-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;research:write&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;202 {job_id}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;POST /v1/models/{name}/retrain&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;command-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;research:write&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;202 {job_id}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PUT /v1/strategies/{id}/enabled&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;command-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ops:admin&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;audited; publishes StrategyToggle&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;POST /v1/ops/dlq/replay&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;command-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ops:admin&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;body {reason, from, to}; audited&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="402" width="1900" height="303" as="geometry"/></mxCell><mxCell id="p7_4" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Common REST rules&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="9.1%"&gt;Item&lt;/td&gt;&lt;td valign="top" width="90.9%"&gt;Rule&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Auth&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Authorization: Bearer &amp;lt;JWT RS256 from Keycloak&amp;gt;; access token 10 min; scopes market:read, trading:read, research:write, ops:admin.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Errors&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;RFC 7807 application/problem+json {type, title, status, detail, trace_id}.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Pagination&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cursor-based: ?limit=&amp;amp;cursor= -&amp;gt; {items, next_cursor}.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Rate limit&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;viewer 60 rpm, researcher 120 rpm, admin 300 rpm per sub; 429 + Retry-After.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Versioning&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;path /v1; additive changes only; deprecation header + 6 months.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Idempotency&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;POST requires Idempotency-Key; same key + same body -&amp;gt; same response for 24 h.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="735" width="1900" height="177" as="geometry"/></mxCell><mxCell id="p7_5" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;WebSocket protocol (AsyncAPI) - realtime-gateway&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="16.7%"&gt;Item&lt;/td&gt;&lt;td valign="top" width="83.3%"&gt;Rule&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Endpoint&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;wss://&amp;lt;host&amp;gt;/ws/v1 (Ingress -&amp;gt; realtime-gateway). First client message must be auth within 5 s, otherwise close 4401.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Client -&amp;gt; server&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;auth {token}; subscribe {channels:[{ch, key}], resume_from:{channel: seq}}; unsubscribe {channels}; pong.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Server -&amp;gt; client&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;snapshot {ch, key, seq, data}; update {ch, key, seq, data}; ping; error {code, msg}; resync_required {ch, key}.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Channels&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;candles.{symbol}.{tf}; ticker.{symbol}; signals.{strategy_id}; positions.{account_id}; risk.{account_id}.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Delivery&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;seq is monotonic per (channel, key). On subscribe: snapshot (Redis) then deltas. Gap or unknown resume_from -&amp;gt; resync_required + fresh snapshot.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Heartbeat / reconnect&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;server ping every 15 s, client pong within 10 s else close. Client reconnect backoff 1,2,4..30 s + jitter, then subscribe with resume_from.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Backpressure&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;bounded queue per connection (1,000 msgs); ticker/candle partials drop-oldest; slow consumer &amp;gt; 5 s -&amp;gt; close 4408.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Close codes&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;4401 unauthorized, 4403 forbidden, 4408 slow consumer, 4429 rate-limited.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="942" width="1900" height="219" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d8" name="08 Data Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1670" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8_1" value='&lt;b style="font-size:20px"&gt;Data architecture - per-store design and ownership&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;R = read, W = write, U = update - every writer is unique per object (ADR-04) - DDL is the starting point for migrations (alembic / clickhouse-migrate)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="p8_2" value="&lt;b style=&quot;font-size:13px&quot;&gt;PostgreSQL 16 - database cip (schema per owner, one DB role per service)&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-family:Courier New;font-size:10px;word-break:break-all;&quot;&gt;-- schema collector (owner: market-collector, historical-ingestor)&lt;br&gt;CREATE TABLE collector.subscriptions(shard_id int, symbol text, channel text, status text, last_seq bigint, updated_at timestamptz DEFAULT now(), PRIMARY KEY(shard_id, symbol, channel));&lt;br&gt;CREATE TABLE collector.backfill_cursors(symbol text, tf text, cursor_ts timestamptz, status text, PRIMARY KEY(symbol, tf));&lt;br&gt;-- schema dq (owner: data-quality)&lt;br&gt;CREATE TABLE dq.incidents(id uuid PRIMARY KEY, symbol text, check_name text, severity text, window_start timestamptz, window_end timestamptz, details jsonb, status text DEFAULT 'open', created_at timestamptz DEFAULT now());&lt;br&gt;CREATE INDEX ON dq.incidents(symbol, created_at DESC);&lt;br&gt;-- schema trading (owners: strategy-engine, paper-execution, portfolio-service)&lt;br&gt;CREATE TABLE trading.strategies(strategy_id text PRIMARY KEY, version text, params jsonb, enabled bool DEFAULT false, updated_at timestamptz);&lt;br&gt;CREATE TABLE trading.signals(signal_id text PRIMARY KEY, strategy_id text REFERENCES trading.strategies, symbol text, side text, strength real, bar_ts timestamptz, reason text, created_at timestamptz DEFAULT now());&lt;br&gt;CREATE TABLE trading.orders(order_id uuid PRIMARY KEY, signal_id text UNIQUE REFERENCES trading.signals, account_id text, symbol text, side text, type text, qty numeric(28,10), limit_px numeric(28,10), status text, reject_reason text, created_at timestamptz, updated_at timestamptz);&lt;br&gt;CREATE TABLE trading.fills(fill_id uuid PRIMARY KEY, order_id uuid REFERENCES trading.orders, qty numeric(28,10), px numeric(28,10), fee numeric(28,10), fee_ccy text, ts timestamptz);&lt;br&gt;CREATE TABLE trading.positions(account_id text, symbol text, qty numeric(28,10), avg_px numeric(28,10), realized_pnl numeric(28,10), unrealized_pnl numeric(28,10), updated_at timestamptz, PRIMARY KEY(account_id, symbol));&lt;br&gt;CREATE TABLE trading.pnl_daily(account_id text, day date, realized numeric(28,10), unrealized numeric(28,10), fees numeric(28,10), PRIMARY KEY(account_id, day));&lt;br&gt;-- schema research (owners: command-api [jobs], backtesting, pairs-research)&lt;br&gt;CREATE TABLE research.jobs(job_id uuid PRIMARY KEY, type text, params jsonb, status text, requested_by text, created_at timestamptz, started_at timestamptz, finished_at timestamptz, artifact_uri text);&lt;br&gt;CREATE TABLE research.backtest_runs(run_id uuid PRIMARY KEY, job_id uuid REFERENCES research.jobs, strategy_id text, strategy_version text, start_ts timestamptz, end_ts timestamptz, metrics jsonb, artifact_uri text);&lt;br&gt;CREATE TABLE research.pair_candidates(pair_id uuid PRIMARY KEY, sym_a text, sym_b text, method text, p_value real, hedge_ratio numeric, half_life_h real, as_of timestamptz, approved bool DEFAULT false);&lt;br&gt;-- schema risk (owner: risk-analytics)&lt;br&gt;CREATE TABLE risk.limits(account_id text, rule_id text, metric text, threshold numeric, action text, PRIMARY KEY(account_id, rule_id));&lt;br&gt;CREATE TABLE risk.snapshots(account_id text, ts timestamptz, gross_exposure numeric, net_exposure numeric, var_95 numeric, max_drawdown numeric, PRIMARY KEY(account_id, ts));&lt;br&gt;-- schema audit (owner: command-api): audit.events(id uuid PK, actor text, action text, target text, payload jsonb, ts timestamptz)&lt;br&gt;-- separate databases (owned by the tool): keycloak, mlflow, airflow&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=top;spacing=8;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1900" height="334" as="geometry"/></mxCell><mxCell id="p8_3" value="&lt;b style=&quot;font-size:13px&quot;&gt;ClickHouse - database market (writers: Kafka-engine MVs + spark-batch only)&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-family:Courier New;font-size:10px;word-break:break-all;&quot;&gt;CREATE TABLE market.ticks (symbol LowCardinality(String), event_ts DateTime64(6,'UTC'), trade_id String, price Decimal(28,10), size Decimal(28,10), side Enum8('BUY'=1,'SELL'=2), ingest_ts DateTime64(6,'UTC'), event_id UUID)&lt;br&gt;ENGINE = ReplacingMergeTree(ingest_ts) PARTITION BY toYYYYMM(event_ts) ORDER BY (symbol, event_ts, trade_id) TTL toDateTime(event_ts) + INTERVAL 90 DAY TO VOLUME 'cold';&lt;br&gt;CREATE TABLE market.ticks_queue (...same columns...) ENGINE = Kafka SETTINGS kafka_broker_list='kafka:9093', kafka_topic_list='market.normalized.v1', kafka_group_name='cg.clickhouse.ticks', kafka_format='AvroConfluent', format_avro_schema_registry_url='http://schema-registry:8081', kafka_num_consumers=4;&lt;br&gt;CREATE MATERIALIZED VIEW market.ticks_mv TO market.ticks AS SELECT * FROM market.ticks_queue;&lt;br&gt;CREATE TABLE market.candles (symbol LowCardinality(String), tf Enum8('1m'=1,'5m'=2,'15m'=3,'1h'=4,'1d'=5), open_ts DateTime64(3,'UTC'), o Decimal(28,10), h Decimal(28,10), l Decimal(28,10), c Decimal(28,10), volume Decimal(28,10), vwap Decimal(28,10), trade_count UInt32, updated_at DateTime64(6,'UTC'))&lt;br&gt;ENGINE = ReplacingMergeTree(updated_at) PARTITION BY toYYYYMM(open_ts) ORDER BY (symbol, tf, open_ts);&lt;br&gt;-- candles_queue (Kafka engine on market.candles.v1) + candles_mv: SELECT ... WHERE is_final = 1.  Reads: use argMax(.., updated_at) or FINAL.&lt;br&gt;CREATE TABLE market.features_log (symbol LowCardinality(String), tf LowCardinality(String), ts DateTime64(3,'UTC'), feature_set_version LowCardinality(String), features Map(String, Float64))&lt;br&gt;ENGINE = MergeTree PARTITION BY toYYYYMMDD(ts) ORDER BY (symbol, tf, ts) TTL toDateTime(ts) + INTERVAL 30 DAY;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=top;spacing=8;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="454" width="1900" height="178" as="geometry"/></mxCell><mxCell id="p8_4" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;MinIO buckets (S3 API)&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="41.7%"&gt;Bucket / prefix&lt;/td&gt;&lt;td valign="top" width="16.7%"&gt;Writer&lt;/td&gt;&lt;td valign="top" width="25.0%"&gt;Format / partitioning&lt;/td&gt;&lt;td valign="top" width="16.7%"&gt;Lifecycle&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip-lake/normalized/trades/date=YYYY-MM-DD/hour=HH/symbol=X/&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;lake-archiver&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Parquet zstd; compacted to &amp;gt;= 128 MB&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;365 d then infrequent tier&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip-lake/curated/candles/tf=1m/date=.../&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;spark-batch&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Parquet&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;forever&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip-lake/features/offline/set=vN/date=.../&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;spark-batch&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Parquet (point-in-time correct)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;365 d&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip-dlq/YYYY/MM/DD/{event_id}.avro&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;dlq-replayer&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Avro + JSON sidecar (error metadata)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;90 d&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip-research/backtests/{run_id}/&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;backtesting&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;equity.parquet, trades.parquet, report.html&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;180 d&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip-ml/mlflow-artifacts/&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;MLflow (clients: model-training)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;MLflow layout&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;registered: keep; unregistered 90 d&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip-flink/checkpoints/{job}/&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Flink&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;RocksDB incremental, retain last 3&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;auto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip-backup/{pg-wal, loki, tempo}&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PostgreSQL, Loki, Tempo&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;native formats&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;14-30 d&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="662" width="1900" height="219" as="geometry"/></mxCell><mxCell id="p8_5" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Redis keyspace (cache semantics: rebuildable from Kafka / ClickHouse; maxmemory-policy volatile-ttl; no persistence required)&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="23.1%"&gt;Key&lt;/td&gt;&lt;td valign="top" width="23.1%"&gt;Type&lt;/td&gt;&lt;td valign="top" width="15.4%"&gt;Writer&lt;/td&gt;&lt;td valign="top" width="30.8%"&gt;Readers&lt;/td&gt;&lt;td valign="top" width="7.7%"&gt;TTL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;snap:candle:{symbol}:{tf}&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;STRING (JSON)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;candle-aggregator&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;realtime-gateway, query-api, portfolio-service&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;24 h&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;snap:last:{symbol}&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;HASH (px, size, ts)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;candle-aggregator&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;paper-execution&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;1 h&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;feat:{symbol}:{tf}&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;HASH (feature -&amp;gt; value, ts, set_version)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;feature-engine&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;strategy-engine, model-inference, query-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;10 min&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ratelimit:{sub}:{route}&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;STRING counter&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;api-gateway&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;api-gateway&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;60 s&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="911" width="1900" height="135" as="geometry"/></mxCell><mxCell id="p8_6" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Data ownership matrix (service x store)&lt;/div&gt