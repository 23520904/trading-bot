ative="1" as="geometry"><mxPoint x="1400.0" y="682" as="sourcePoint"/><mxPoint x="1400.0" y="1124" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_47" value="Alertmanager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="638" width="150" height="44" as="geometry"/></mxCell><mxCell id="p11_48" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#aaaaaa;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1585.0" y="682" as="sourcePoint"/><mxPoint x="1585.0" y="1124" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_49" value="1. submit offline-features" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="716" as="sourcePoint"/><mxPoint x="290.0" y="716" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_50" value="2. write features/offline/set=vN" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290.0" y="750" as="sourcePoint"/><mxPoint x="475.0" y="750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_51" value="3. start training Job" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="784" as="sourcePoint"/><mxPoint x="660.0" y="784" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_52" value="4. read offline features" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="818" as="sourcePoint"/><mxPoint x="475.0" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_53" value="5. log run, register model" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="852" as="sourcePoint"/><mxPoint x="845.0" y="852" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_54" value="6. alias champion if better" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="886" as="sourcePoint"/><mxPoint x="845.0" y="886" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_55" value="7. poll alias 60 s -&amp;gt; load model" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030.0" y="920" as="sourcePoint"/><mxPoint x="845.0" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_56" value="8. Prediction [predictions.v1]" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;verticalAlign=bottom;align=center;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030.0" y="954" as="sourcePoint"/><mxPoint x="1215.0" y="954" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_57" value="9. poll features + predictions" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;verticalAlign=bottom;align=center;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215.0" y="988" as="sourcePoint"/><mxPoint x="1400.0" y="988" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_58" value="10. PSI / KS &amp;gt; threshold -&amp;gt; alert" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;verticalAlign=bottom;align=center;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400.0" y="1022" as="sourcePoint"/><mxPoint x="1585.0" y="1022" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_59" value="11. JobRequest retrain [research.jobs.v1]" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;verticalAlign=bottom;align=center;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400.0" y="1056" as="sourcePoint"/><mxPoint x="1215.0" y="1056" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p11_60" value="12. start retrain (KEDA)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;verticalAlign=bottom;align=center;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215.0" y="1090" as="sourcePoint"/><mxPoint x="660.0" y="1090" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="d12" name="12 Deployment (Kubernetes)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1447" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p12_1" value='&lt;b style="font-size:20px"&gt;Deployment view - Kubernetes&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;One cluster, 1 region / 3 zones (A1) - namespaces = trust and ownership zones - GitOps with Argo CD - details of policies below&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="p12_2" value="Kubernetes cluster (managed K8s, node pools: general / data (local NVMe) / batch (spot, optional GPU))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#888888;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="2420" height="570" as="geometry"/></mxCell><mxCell id="p12_3" value="&lt;b style=&quot;font-size:12px&quot;&gt;ns/ingress-system&lt;/b&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;&quot;&gt;&amp;bull; ingress-nginx: Deployment x2, L4 LoadBalancer&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;&quot;&gt;&amp;bull; cert-manager: Deployment x1 (Let's Encrypt)&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;&quot;&gt;&amp;bull; external-dns: Deployment x1&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="540" height="130" as="geometry"/></mxCell><mxCell id="p12_4" value='&lt;b style="font-size:12px"&gt;ns/app&lt;/b&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; web-dashboard: Deployment x2 (static)&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; api-gateway: Deployment 2-6, HPA cpu 70%&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; query-api: Deployment 2-6, HPA cpu + p95&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; command-api: Deployment x2&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; realtime-gateway: Deployment 2-8, KEDA on ws_connections&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; keycloak: Deployment x2 (DB on cloudnative-pg)&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="650" y="130" width="540" height="130" as="geometry"/></mxCell><mxCell id="p12_5" value='&lt;b style="font-size:12px"&gt;ns/streaming&lt;/b&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; kafka: Strimzi, 3 brokers KRaft, RF=3, PVC 500Gi each, rack-aware&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; schema-registry: Deployment x2&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; Flink Kubernetes Operator -&amp;gt; FlinkDeployments: candle-aggregator (p=4), feature-engine (p=2), lake-archiver (p=2); RocksDB state, checkpoints to MinIO every 30 s&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1250" y="130" width="540" height="130" as="geometry"/></mxCell><mxCell id="p12_6" value='&lt;b style="font-size:12px"&gt;ns/data&lt;/b&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; postgresql: CloudNativePG 3 instances (1 primary + 2 replicas), WAL archive to MinIO, PITR&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; clickhouse: Altinity operator, 1 shard x 2 replicas + 3 Keeper, NVMe PVC&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; redis: Sentinel x3, cache semantics&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; minio: operator, 4 nodes EC:2, versioning on cip-lake&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1850" y="130" width="540" height="130" as="geometry"/></mxCell><mxCell id="p12_7" value='&lt;b style="font-size:12px"&gt;ns/ingest&lt;/b&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; market-collector: StatefulSet, 1 pod per symbol shard (&amp;lt;= 25 symbols), Lease leader election&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; historical-ingestor: CronJob daily + on-demand Job&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; data-validator: Deployment 2-12, KEDA on Kafka lag&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; market-normalizer: Deployment 2-12, KEDA&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; dlq-replayer: Deployment x1&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; data-quality: Deployment x2&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="50" y="310" width="540" height="143" as="geometry"/></mxCell><mxCell id="p12_8" value='&lt;b style="font-size:12px"&gt;ns/trading&lt;/b&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; strategy-engine: Deployment x2 (consumer-group partition assignment)&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; paper-execution: Deployment 2-6, KEDA&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; portfolio-service: Deployment x2 (partition by account)&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; risk-analytics: Deployment 1-2&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="650" y="310" width="540" height="143" as="geometry"/></mxCell><mxCell id="p12_9" value='&lt;b style="font-size:12px"&gt;ns/ml-research&lt;/b&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; model-inference: Deployment x2&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; model-monitoring: Deployment x1&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; model-training: Job / CronJob (GPU pool optional)&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; backtesting: KEDA ScaledJob on research.jobs.v1&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; pairs-research: Job&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; mlflow: Deployment x2 (PG backend, MinIO artifacts)&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1250" y="310" width="540" height="143" as="geometry"/></mxCell><mxCell id="p12_10" value='&lt;b style="font-size:12px"&gt;ns/batch&lt;/b&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; airflow: Helm chart, KubernetesExecutor&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; spark-operator: SparkApplications parquet-compaction, candle-backfill, offline-features&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; node pool: batch (spot)&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1850" y="310" width="540" height="143" as="geometry"/></mxCell><mxCell id="p12_11" value='&lt;b style="font-size:12px"&gt;ns/observability&lt;/b&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; otel-collector: DaemonSet agent + Deployment gateway&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; prometheus (kube-prometheus-stack) + alertmanager&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; grafana&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; loki (S3 chunks)&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; tempo (S3)&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="50" y="503" width="540" height="117" as="geometry"/></mxCell><mxCell id="p12_12" value='&lt;b style="font-size:12px"&gt;ns/platform&lt;/b&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; argocd (GitOps), argo-rollouts&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; external-secrets -&amp;gt; Vault / KMS&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; kyverno (policy: signed images, no latest tag)&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; linkerd (mTLS)&lt;/div&gt;&lt;div style="text-align:left;font-size:10px;padding-left:10px;text-indent:-10px;"&gt;&amp;bull; default-deny NetworkPolicies&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="650" y="503" width="540" height="117" as="geometry"/></mxCell><mxCell id="p12_13" value="HTTP 8080" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;labelBackgroundColor=#FFFFFF;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="p12_3" target="p12_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_14" value="Kafka 9093 mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;labelBackgroundColor=#FFFFFF;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p12_4" target="p12_5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_15" value="RESP / HTTP / S3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;labelBackgroundColor=#FFFFFF;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="p12_5" target="p12_6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12_16" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;NetworkPolicy allow-list (default deny)&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="30.0%"&gt;From -&amp;gt; To&lt;/td&gt;&lt;td valign="top" width="20.0%"&gt;Port / proto&lt;/td&gt;&lt;td valign="top" width="50.0%"&gt;Purpose&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;internet -&amp;gt; ingress-system&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;443 TLS&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;users&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ingress-system -&amp;gt; app&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;8080 HTTP&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;api-gateway, realtime-gateway, web-dashboard only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;app -&amp;gt; data&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;5432, 8123, 6379&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PG, ClickHouse, Redis: query-api, command-api, realtime-gateway, api-gateway (Redis rate limit)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;app -&amp;gt; streaming&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;9093 mTLS&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;command-api produce; realtime-gateway consume&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ingest / trading / ml-research -&amp;gt; streaming&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;9093 mTLS, 8081&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Kafka + Schema Registry, ACL per service principal&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;streaming (Flink) -&amp;gt; data&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;6379, 8123, 9000&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Redis, ClickHouse, MinIO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;batch, ml-research -&amp;gt; data&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;9000, 8123, 5432&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;MinIO, ClickHouse, PG (mlflow DB)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;* -&amp;gt; observability&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;4317 OTLP&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;telemetry&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;egress allow-list (443)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ingest -&amp;gt; Coinbase only; observability -&amp;gt; Slack/PagerDuty; CI -&amp;gt; GitHub&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;everything else denied&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="50" y="720" width="1150" height="253" as="geometry"/></mxCell><mxCell id="p12_17" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Environments&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="14.3%"&gt;Env&lt;/td&gt;&lt;td valign="top" width="85.7%"&gt;Description&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;local&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;docker-compose: 1 Kafka KRaft, Schema Registry, ClickHouse, PG, Redis, MinIO, Keycloak; Flink mini-cluster; 1 symbol, live or recorded-frame replay.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;dev&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;small K8s, 1 replica per service, 3 symbols, Argo CD auto-sync from main.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;staging&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;prod-like at ~50% size, 20 symbols, nightly load test (k6 + Kafka producer perf: 5k msg/s for 30 min).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;prod&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;full size, 100 symbols, manual approval, Argo Rollouts progressive delivery.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="50" y="1003" width="1150" height="135" as="geometry"/></mxCell><mxCell id="p12_18" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;CI/CD pipeline (GitHub Actions + Argo CD)&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="8.3%"&gt;#&lt;/td&gt;&lt;td valign="top" width="25.0%"&gt;Stage&lt;/td&gt;&lt;td valign="top" width="66.7%"&gt;Detail&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;lint + types + unit&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ruff, mypy, pytest, Flink MiniCluster tests&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;2&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;contract checks&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Avro compatibility vs Schema Registry, OpenAPI diff (oasdiff), AsyncAPI lint&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;3&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;integration&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;testcontainers: Kafka, PG, ClickHouse, Redis, MinIO; recorded Coinbase frames&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;4&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;build + supply chain&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;container build, SBOM (syft), Trivy (block HIGH), cosign sign, push GHCR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;5&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;migrations dry-run&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;alembic (per PG schema), clickhouse-migrate&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;6&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;deploy dev&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Argo CD auto-sync&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;7&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;staging gate&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;smoke tests + load test + parity test (offline vs online features)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;8&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;deploy prod&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;manual approval, Argo Rollouts canary, auto-rollback on SLO burn&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="50" y="1168" width="1150" height="219" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d13" name="13 Observability, Security, NFR"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="1542" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p13_1" value='&lt;b style="font-size:20px"&gt;Cross-cutting - observability pipeline (drawn once for all containers)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;Arrow = data flow - one OTel pipeline; trace context propagated via HTTP headers and Kafka headers (traceparent)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="p13_2" value='&lt;b&gt;all application containers&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#444444"&gt;[Container: OTel SDK, Prometheus client]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#222222"&gt;Traces (OTLP), metrics (/metrics), JSON logs (stdout). traceparent in Kafka headers.&lt;/span&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1a1a1a;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="270" height="110" as="geometry"/></mxCell><mxCell id="p13_3" value='&lt;b&gt;otel-collector&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#444444"&gt;[Container: OpenTelemetry Collector]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#222222"&gt;Agent (DaemonSet) -&amp;gt; gateway (Deployment); batching, tail sampling 10% + errors.&lt;/span&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1a1a1a;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="250" height="110" as="geometry"/></mxCell><mxCell id="p13_4" value='&lt;b&gt;prometheus&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#444444"&gt;[Container: kube-prometheus-stack]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#222222"&gt;Metrics TSDB, rules, ServiceMonitors&lt;/span&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1a1a1a;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="790" y="20" width="230" height="80" as="geometry"/></mxCell><mxCell id="p13_5" value='&lt;b&gt;loki&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#444444"&gt;[Container: Grafana Loki, S3 chunks]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#222222"&gt;Log store (JSON logs)&lt;/span&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1a1a1a;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="790" y="140" width="230" height="80" as="geometry"/></mxCell><mxCell id="p13_6" value='&lt;b&gt;tempo&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#444444"&gt;[Container: Grafana Tempo, S3]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#222222"&gt;Trace store&lt;/span&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1a1a1a;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="790" y="260" width="230" height="80" as="geometry"/></mxCell><mxCell id="p13_7" value='&lt;b&gt;grafana&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#444444"&gt;[Container: Grafana 11]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#222222"&gt;Dashboards, explore, SLO views&lt;/span&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1a1a1a;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1160" y="140" width="230" height="80" as="geometry"/></mxCell><mxCell id="p13_8" value='&lt;b&gt;alertmanager&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#444444"&gt;[Container: Alertmanager]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#222222"&gt;Routing, grouping, silences&lt;/span&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1a1a1a;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1160" y="20" width="230" height="80" as="geometry"/></mxCell><mxCell id="p13_9" value='&lt;b&gt;Slack / PagerDuty&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#444444"&gt;[External System: receiver]&lt;/span&gt;' style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontColor=#1a1a1a;rounded=1;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1500" y="20" width="200" height="80" as="geometry"/></mxCell><mxCell id="p13_10" value="OTLP gRPC 4317" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;labelBackgroundColor=#FFFFFF;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="p13_2" target="p13_3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13_11" value="remote write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;labelBackgroundColor=#FFFFFF;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="p13_3" target="p13_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13_12" value="push logs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;labelBackgroundColor=#FFFFFF;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p13_3" target="p13_5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13_13" value="OTLP traces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;labelBackgroundColor=#FFFFFF;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="p13_3" target="p13_6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13_14" value="fires alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;labelBackgroundColor=#FFFFFF;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="p13_4" target="p13_8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13_15" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;labelBackgroundColor=#FFFFFF;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="p13_8" target="p13_9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13_16" value="PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;labelBackgroundColor=#FFFFFF;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;exitX=1;exitY=0.8;entryX=0.2;entryY=0;" edge="1" parent="1" source="p13_4" target="p13_7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13_17" value="LogQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;labelBackgroundColor=#FFFFFF;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;" edge="1" parent="1" source="p13_5" target="p13_7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13_18" value="TraceQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;labelBackgroundColor=#FFFFFF;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;exitX=1;exitY=0.3;entryX=0.2;entryY=1;" edge="1" parent="1" source="p13_6" target="p13_7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13_19" value='&lt;b&gt;Legend&lt;/b&gt;&lt;table cellspacing="2" cellpadding="1" style="font-size:10px;"&gt;&lt;tr&gt;&lt;td bgcolor="#dae8fc" style="border:1px solid #6c8ebf;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;Application container (own code)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td bgcolor="#ffe6cc" style="border:1px solid #d79b00;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;Processing engine job (Flink / Spark / Airflow)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td bgcolor="#e1d5e7" style="border:1px solid #9673a6;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;Kafka cluster / topic (pill)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td bgcolor="#d5e8d4" style="border:1px solid #82b366;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;Datastore (cylinder)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px dashed #666666;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;External system (dashed)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="center"&gt;&amp;#9472;&amp;#9472;&amp;#9654;&lt;/td&gt;&lt;td&gt;Synchronous call / connection&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="center"&gt;&amp;#9480;&amp;#9480;&amp;#9654;&lt;/td&gt;&lt;td&gt;Asynchronous / event via Kafka&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;span style="font-size:10px;color:#555555"&gt;Arrow = caller -&amp;gt; callee&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="330" height="190" as="geometry"/></mxCell><mxCell id="p13_20" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;SLI / SLO and alerts&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="15.4%"&gt;SLI&lt;/td&gt;&lt;td valign="top" width="30.8%"&gt;SLO (proposed)&lt;/td&gt;&lt;td valign="top" width="30.8%"&gt;Measurement&lt;/td&gt;&lt;td valign="top" width="23.1%"&gt;Alert&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Pipeline freshness&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;tick -&amp;gt; candle p95 &amp;lt;= 1 s&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip_pipeline_e2e_seconds&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;page if p95 &amp;gt; 2 s for 5 min&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Dashboard latency&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;tick -&amp;gt; WS update p95 &amp;lt;= 500 ms&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip_ws_e2e_seconds&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;warn &amp;gt; 1 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Completeness&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;raw -&amp;gt; normalized &amp;gt;= 99.99% (excluding DLQ)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;per-symbol per-minute count compare&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ticket&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;DLQ rate&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;&amp;lt;= 0.1% of raw (5 min)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;invalid_total / frames_total&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;warn 1%, page 5%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Feed liveness&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;no symbol silent &amp;gt; 30 s&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip_ingest_last_event_age_seconds&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;page&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;API&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;99.9% availability (30 d); p95 &amp;lt;= 300 ms (&amp;lt;= 5k rows)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;http_server_duration&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;burn-rate 2% / 1 h&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Consumer lag&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;&amp;lt; 10k msgs or &amp;lt; 30 s&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;kafka_consumergroup_lag&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;warn after 5 min&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Paper trading&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;signal -&amp;gt; order p95 &amp;lt;= 1 s&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip_signal_to_order_seconds&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;warn&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Model drift&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PSI &amp;lt; 0.2 per feature&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cip_model_psi{model,feature}&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ticket + retrain job&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="1900" height="240" as="geometry"/></mxCell><mxCell id="p13_21" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Telemetry conventions&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="9.1%"&gt;Signal&lt;/td&gt;&lt;td valign="top" width="90.9%"&gt;Rule&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Metrics&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;name = cip_&amp;lt;domain&amp;gt;_&amp;lt;name&amp;gt;_&amp;lt;unit&amp;gt;; labels service, symbol (&amp;lt;= 100), tf, topic; no high-cardinality labels (ids).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Logs&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;JSON to stdout: ts, level, service, trace_id, span_id, event, symbol; collected by OTel -&amp;gt; Loki.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Traces&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;W3C traceparent in HTTP and Kafka headers; head sampling 10% + 100% errors (tail sampling in collector).&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="1900" height="114" as="geometry"/></mxCell><mxCell id="p13_22" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Security controls&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="9.1%"&gt;Control&lt;/td&gt;&lt;td valign="top" width="90.9%"&gt;Implementation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Edge TLS&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;cert-manager, TLS 1.3, HSTS.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;AuthN&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Keycloak OIDC code + PKCE; JWT RS256; access 10 min, refresh 8 h; JWKS cached 10 min in api-gateway and realtime-gateway.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;AuthZ&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;scope -&amp;gt; route in api-gateway; resource checks in services; admin actions written to audit.events.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Service-to-service&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Linkerd mTLS; default-deny NetworkPolicies.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Kafka&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;mTLS + ACL per service principal (produce / consume only own topics); Schema Registry writes restricted to CI.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Datastores&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;one DB role per service (least privilege), read-only roles for cross-owner reads; secrets via External Secrets -&amp;gt; Vault, rotated 90 d.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Secrets&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;none in Git; Coinbase public channels need none (A5).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Supply chain&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;SBOM, Trivy gate, cosign signature verified by Kyverno.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Data classes&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market data = public; positions / PnL (paper) = internal; user identity = confidential.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="1014" width="1900" height="240" as="geometry"/></mxCell><mxCell id="p13_23" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Non-functional requirements (all values proposed)&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="15.4%"&gt;Attribute&lt;/td&gt;&lt;td valign="top" width="61.5%"&gt;Target&lt;/td&gt;&lt;td valign="top" width="23.1%"&gt;Basis&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Throughput&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;5,000 msg/s sustained, 20,000 burst (x4 headroom)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;A2; load test at M6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Latency&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;see SLO table&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;A3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Availability&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;read path 99.9%; ingestion 99.5% (single region)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;proposed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Durability&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;RPO &amp;lt;= 1 min Kafka (RF=3), &amp;lt;= 5 min PG (WAL), MinIO EC; RTO &amp;lt;= 30 min (Argo CD resync + restore)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;proposed; DR drill at M6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Scalability&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;100 -&amp;gt; 500 symbols: partitions 12 -&amp;gt; 48 and Flink parallelism x4 (planned re-key)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;proposed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Consistency&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;eventual across views; per-symbol ordering; ClickHouse dedupe after merge (use argMax / FINAL)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ADR-05&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Cost&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;TBD - budget unknown; first estimate after M2 load test&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;A10&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="1284" width="1900" height="198" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d14" name="14 Failure Modes &amp; Risks"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="765" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p14_1" value='&lt;b style="font-size:20px"&gt;Failure modes &amp;amp; risk register&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;Each failure has detection and mitigation owned by a service spec (pages 15-16)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="p14_2" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Failure modes&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="18.8%"&gt;Failure&lt;/td&gt;&lt;td valign="top" width="12.5%"&gt;Impact&lt;/td&gt;&lt;td valign="top" width="18.8%"&gt;Detection&lt;/td&gt;&lt;td valign="top" width="50.0%"&gt;Mitigation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Coinbase WS disconnect / sequence gap&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;missing ticks&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;gap-detector; feed-liveness alert&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;auto reconnect with backoff, re-subscribe, BackfillRequest via ops.commands -&amp;gt; REST backfill; dedupe absorbs overlap&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Duplicates (reconnect, replay, at-least-once)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;double counting&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;dup-rate metric&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;event_id / trade_id dedupe (Flink 10 min state; ClickHouse ReplacingMergeTree); idempotent consumers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Out-of-order / late data&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;wrong candles&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;late-events counter&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;watermark 2 s, allowedLateness 30 s; later -&amp;gt; market.late.v1; Spark candle-backfill corrects (updated_at version)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Schema drift / unknown fields&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;validator rejects&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;invalid_total by reason&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;DLQ + Schema Registry compatibility; alert; fix then replay&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Poison pill / bad deploy&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;consumer crash loop&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;restarts, lag&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;DLQ on deserialization error; Argo Rollouts rollback; 3 retries then DLQ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Backpressure / consumer lag&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;stale data&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;consumer lag&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;KEDA scale-out up to partition count; Flink backpressure metrics; gateway drops oldest ticker updates&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Kafka broker loss&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;leader failover&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;under-replicated partitions&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;RF=3, min.insync=2, rack-aware; idempotent producers retry&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Flink job / checkpoint failure&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;candles stop&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;job status, checkpoint age&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;auto restart from last checkpoint (30 s interval); EOS sinks; alert if checkpoint age &amp;gt; 2 min&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ClickHouse outage&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;queries fail; ingestion lag in Kafka&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;up, query errors&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Kafka keeps 7 d -&amp;gt; catch-up; query-api returns 503 or Redis snapshot; 2 replicas&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Redis outage&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;snapshots / features missing&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;health&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;strategy-engine pauses (no features -&amp;gt; no signals); WS clients resync after recovery; Flink jobs re-warm keys&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PostgreSQL failover&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;brief write errors&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;CNPG events&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;retry with backoff; idempotent writes; read-only &amp;lt;= 30 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Clock skew&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;wrong timestamps&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ts-skew histogram&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;chrony; event_ts from exchange; validator rejects &amp;gt; 5 s in future&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Model drift / bad model&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;bad signals&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PSI / KS, PnL deviation&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;alert; move alias champion back; strategy-engine ignores stale predictions&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Strategy runaway (paper)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;exposure beyond limits&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;risk metrics&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;risk.alerts.v1 -&amp;gt; paper-execution halts; admin toggle via command-api&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Coinbase rate limit / outage&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;slow backfill&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;HTTP 429&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;token bucket 10 rps, honor Retry-After; resumable cursor&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1900" height="366" as="geometry"/></mxCell><mxCell id="p14_3" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Risk register (likelihood / impact)&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="6.7%"&gt;ID&lt;/td&gt;&lt;td valign="top" width="33.3%"&gt;Risk&lt;/td&gt;&lt;td valign="top" width="6.7%"&gt;L / I&lt;/td&gt;&lt;td valign="top" width="53.3%"&gt;Mitigation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;R1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PyFlink maturity / performance&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;M / H&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;benchmark in M1; fallback to Java for hot jobs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;R2&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Ops load: Kafka + Flink + Spark + ClickHouse with small team&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;H / H&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;operators, runbooks, staged rollout M0-M6; drop Spark if possible (ADR-01)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;R3&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Training-serving skew&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;M / H&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;shared cip-core spec; parity test offline vs online in CI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;R4&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Backtest look-ahead / overfitting&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;H / M&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;point-in-time data API, walk-forward, embargo; strategy-core forbids future access&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;R5&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Coinbase feed / API changes&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;M / M&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;adapter layer + schema versioning; contract tests on recorded fixtures&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;R6&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ReplacingMergeTree dedupe semantics&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;M / M&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;argMax / FINAL in views; tests&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;R7&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;WebSocket fan-out scale&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;L / M&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;load test 1k clients; Redis fan-out tier (ADR-06)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;R8&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Cost overrun&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;M / M&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;A10; scale jobs to zero; spot pool for batch&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="486" width="1900" height="219" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d15" name="15 Service Specs 1-2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2090" pageHeight="617" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p15_1" value='&lt;b style="font-size:20px"&gt;Service spec cards (1/2)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;One row = one deployable container - implement against: topic catalog (06), contracts (07), data ownership (08) - DoD = definition of done&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="p15_2" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Specs&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="8.0%"&gt;Service&lt;/td&gt;&lt;td valign="top" width="24.0%"&gt;Responsibility, inputs -&amp;gt; outputs&lt;/td&gt;&lt;td valign="top" width="12.0%"&gt;Owned data&lt;/td&gt;&lt;td valign="top" width="20.0%"&gt;Stack, scaling, state&lt;/td&gt;&lt;td valign="top" width="16.0%"&gt;Idempotency, retry&lt;/td&gt;&lt;td valign="top" width="20.0%"&gt;Tests, definition of done&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market-collector&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Coinbase WSS -&amp;gt; raw frames. Out: market.raw.v1, ops.commands (BackfillRequest)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PG collector.subscriptions&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python 3.12, asyncio, websockets, confluent-kafka; StatefulSet, 1 pod per shard; K8s Lease&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;event_id UUIDv7; idempotent producer; reconnect 1-30 s + jitter&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Recorded-frame replay, chaos disconnect. DoD: 0 gaps after 60 s outage&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;historical-ingestor&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;REST backfill. In: BackfillRequest, schedule. Out: market.raw.backfill.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PG collector.backfill_cursors&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python httpx + tenacity; CronJob / Job; cursor in PG&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;resumable by cursor; 429 -&amp;gt; Retry-After; downstream dedupe&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;VCR cassettes. DoD: 30 d BTC-USD &amp;lt; 15 min&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;data-validator&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Gate: Avro decode + rules (price &amp;gt; 0, size &amp;gt; 0, ts skew, symbol whitelist, seq monotonic). In: raw, raw.backfill. Out: validated, dlq&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;-&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python, confluent-kafka, fastavro; Deployment 2-12, KEDA on lag; stateless&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;manual commit after produce; poison -&amp;gt; DLQ at once; transient retry 3x&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Property tests (hypothesis). DoD: invalid never reaches validated&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market-normalizer&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Canonical model (BTC-USD, Decimal, UTC us, side enum). In: validated. Out: normalized, dlq&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;-&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python; Deployment 2-12, KEDA; stateless&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;deterministic mapping =&amp;gt; replay-safe&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Golden files per channel. DoD: 100% fields mapped&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;dlq-replayer&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Archive dead letters; replay on command. In: dlq, ops.commands. Out: MinIO cip-dlq, raw.backfill&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;MinIO cip-dlq/&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python; Deployment x1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;event_id preserved, ingest_mode=replay&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;testcontainers. DoD: replay 10k msgs, 0 duplicates downstream&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;data-quality&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Windowed checks: gaps, staleness, dup-rate, price spikes (z &amp;gt; 8), volume anomalies. In: normalized, late. Out: incidents, metrics&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PG dq.*&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python; Deployment x2 (partitioned); 1-min windows&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;incident key (symbol, check, window) upsert&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Fault injection. DoD: detects 1-min gap within 90 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;candle-aggregator&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Candles 1m..1d (OHLCV, VWAP, count). In: normalized. Out: candles, late, Redis snap:*&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Redis snap:candle:*, snap:last:*&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Flink 1.19, RocksDB, p=4, checkpoint 30 s&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;dedupe trade_id 10 min; EOS Kafka txn; Redis SET idempotent&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;MiniCluster + out-of-order fixtures. DoD: equals Spark recompute (parity)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;feature-engine&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Online features from candles. In: candles. Out: features.online.v1, Redis feat:*&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Redis feat:*&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Flink, p=2, spec from cip-core&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;EOS; HSET idempotent; feature_set_version&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Offline vs online parity. DoD: max abs diff &amp;lt; 1e-9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;lake-archiver&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Normalized trades -&amp;gt; Parquet in MinIO. In: normalized&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;MinIO cip-lake/normalized&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Flink FileSink, Parquet + zstd, hourly roll, p=2&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;exactly-once via checkpoint-committed files&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Read-back test. DoD: row count = Kafka offsets&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;spark-batch&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Compaction, candle-backfill, offline-features. In: MinIO, CH. Out: MinIO curated, CH candles&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;MinIO cip-lake/curated, features&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Spark 3.5 on K8s operator; spot executors&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;overwrite partitions (idempotent); run_id logged&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Small-data local tests. DoD: backfill = real-time candles within tolerance&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;airflow&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Orchestrates batch DAGs and retrains. Out: SparkApplications, K8s Jobs, research.jobs.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;own metadata DB&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Airflow 2 Helm, KubernetesExecutor&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;idempotent tasks; retries 3; SLA alerts&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;DAG integrity tests. DoD: backfill DAG re-run is a no-op&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;strategy-engine&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Runs strategies per bar. In: candles, predictions, Redis feat:*, PG strategies / pairs, ops.commands. Out: signals.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PG trading.strategies, trading.signals&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python, strategy-core; Deployment x2 (partition assignment)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;signal_id = hash(strategy, symbol, bar_ts); idempotent publish&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Deterministic replay: same candles =&amp;gt; same signals. DoD: parity with backtest&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;paper-execution&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Simulated fills (fees, slippage, latency) + pre-trade risk check. In: signals, risk.alerts. Out: orders.v1, fills.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PG trading.orders, fills&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python; Deployment 2-6 (KEDA); ExecutionPort impl&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;orders.signal_id UNIQUE; TX write then publish (outbox)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Simulator unit tests. DoD: duplicate signal =&amp;gt; 1 order&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="2000" height="467" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d16" name="16 Service Specs 2-2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2090" pageHeight="565" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p16_1" value='&lt;b style="font-size:20px"&gt;Service spec cards (2/2)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;One row = one deployable container - implement against: topic catalog (06), contracts (07), data ownership (08) - DoD = definition of done&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="p16_2" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Specs&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="8.0%"&gt;Service&lt;/td&gt;&lt;td valign="top" width="24.0%"&gt;Responsibility, inputs -&amp;gt; outputs&lt;/td&gt;&lt;td valign="top" width="12.0%"&gt;Owned data&lt;/td&gt;&lt;td valign="top" width="20.0%"&gt;Stack, scaling, state&lt;/td&gt;&lt;td valign="top" width="16.0%"&gt;Idempotency, retry&lt;/td&gt;&lt;td valign="top" width="20.0%"&gt;Tests, definition of done&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;portfolio-service&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Positions, avg price, realized / unrealized PnL. In: fills, snap:candle. Out: positions.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PG trading.positions, pnl_daily&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python; Deployment x2 (partition by account)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;fill_id dedupe; UPSERT idempotent&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Ledger invariants (property tests). DoD: sum of fills = position&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;risk-analytics&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Exposure, VaR95, drawdown; limit breach alerts. In: positions. Out: risk.alerts.v1, PG risk.*&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PG risk.*&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python, numpy / pandas; Deployment 1-2&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;alert key (account, rule_id, window)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Scenario tests. DoD: breach =&amp;gt; alert &amp;lt;= 1 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;model-inference&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Online scoring. In: features.online.v1, MLflow alias. Out: predictions.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;- (model cache)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python, MLflow client, ONNX / sklearn; Deployment x2; hot-swap&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;idempotent by (symbol, ts, model_version)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Golden predictions. DoD: p95 &amp;lt; 50 ms per event&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;model-training&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Train, evaluate, register. In: MinIO features, research.jobs.v1. Out: MLflow runs / models&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;MLflow (cip-ml)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python (sklearn / xgboost / PyTorch); K8s Job, GPU optional&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;seeded; data snapshot id logged&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Reproducibility test. DoD: same data + seed =&amp;gt; same metrics&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;model-monitoring&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Drift (PSI / KS) and performance decay. In: features, predictions. Out: metrics, research.jobs.v1 (retrain)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;-&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python; Deployment x1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;windowed; alert dedupe in Alertmanager&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Synthetic shift. DoD: alert fires on PSI &amp;gt; 0.2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;mlflow&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Tracking + model registry&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PG db mlflow; MinIO cip-ml&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;MLflow 2; Deployment x2&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;-&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Smoke test. DoD: registry meets API SLO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;pairs-research&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Cointegration (Engle-Granger, Johansen), hedge ratio, half-life. In: CH candles, research.jobs.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PG research.pair_candidates&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python, statsmodels; K8s Job&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;upsert by job_id&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Synthetic cointegrated series. DoD: 20 symbols &amp;lt; 5 min&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;backtesting&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Event-driven backtests via strategy-core + simulator. In: CH / MinIO data, research.jobs.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PG research.backtest_runs; MinIO cip-research&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Python; KEDA ScaledJob&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;run_id = hash(strategy_version, params, data_snapshot)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Golden-run regression, no look-ahead test. DoD: reproducible&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;api-gateway&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;AuthN/Z, routing, rate limit. In: HTTPS. Out: HTTP to query-api / command-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Redis ratelimit:*&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;FastAPI + authlib; Deployment 2-6, HPA; stateless&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;stateless&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;OpenAPI contract tests. DoD: 401 / 403 / 429 covered&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;query-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Read side: candles, ticks, features, trading, results. Out: JSON&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;- (RO roles on CH / PG / Redis)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;FastAPI, clickhouse-connect, asyncpg, redis-py; Deployment 2-6, HPA&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;GET idempotent; ETag / Cache-Control&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Schemathesis. DoD: p95 &amp;lt;= 300 ms&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;command-api&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Write side: jobs, strategy toggle, DLQ replay; audit&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;PG research.jobs, audit.events&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;FastAPI; Deployment x2&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Idempotency-Key; TX + outbox publish&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Contract + authZ tests. DoD: every command audited&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;realtime-gateway&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;WSS fan-out, snapshot + delta. In: Kafka candles / signals / positions, Redis snap:*&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;-&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Starlette WS, aiokafka, redis-py; Deployment 2-8, HPA on connections&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;per-channel seq; resync on gap&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Load test 1k clients. DoD: server-side p95 &amp;lt;= 100 ms&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;web-dashboard&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;UI: charts, research, paper trading, reconnect UX&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;-&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;React 18, TypeScript, Vite, lightweight-charts, TanStack Query; nginx static&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;-&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Playwright e2e. DoD: reconnect and resync tested&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="2000" height="415" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d17" name="17 Repo Layout &amp; Roadmap"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1990" pageHeight="674" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p17_1" value='&lt;b style="font-size:20px"&gt;Repository layout &amp;amp; roadmap&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;Monorepo - contracts first - vertical slices - build order: walking skeleton (M0) then add one vertical slice per milestone&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="p17_2" value='&lt;b style="font-size:13px"&gt;Monorepo layout&lt;/b&gt;&lt;br&gt;&lt;div style="font-family:Courier New;font-size:11px;word-break:break-all;"&gt;cip/&lt;br&gt;|-- libs/        cip-core (domain types, candle &amp;amp; feature specs, Avro codegen), cip-kafka (producer/consumer: idempotency, DLQ, tracing),&lt;br&gt;|                cip-obs (OTel, logging, metrics), cip-auth (JWT/JWKS), strategy-core (strategy API + execution simulator)&lt;br&gt;|-- schemas/     avro/*.avsc, openapi/*.yaml, asyncapi/ws.yaml          (CI: compatibility checks)&lt;br&gt;|-- services/    market-collector, historical-ingestor, data-validator, market-normalizer, dlq-replayer, data-quality,&lt;br&gt;|                strategy-engine, paper-execution, portfolio-service, risk-analytics, model-inference, model-monitoring,&lt;br&gt;|                api-gateway, query-api, command-api, realtime-gateway&lt;br&gt;|-- jobs/        flink/{candle-aggregator, feature-engine, lake-archiver}, spark/{parquet-compaction, candle-backfill, offline-features},&lt;br&gt;|                ml/model-training, research/{pairs-research, backtesting}, airflow/dags&lt;br&gt;|-- web/         dashboard (React + Vite + TypeScript)&lt;br&gt;|-- db/          postgres/migrations (alembic per schema), clickhouse/migrations&lt;br&gt;|-- deploy/      helm/ (per service), kustomize/{dev,staging,prod}, argocd/&lt;br&gt;|-- tools/       docker-compose.yml (local), seed + replay scripts, load tests (k6, kafka-producer-perf)&lt;br&gt;`-- docs/        this design pack (.drawio), ADRs&lt;br&gt;&lt;/div&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;align=left;verticalAlign=top;spacing=8;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1900" height="244" as="geometry"/></mxCell><mxCell id="p17_3" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Roadmap with acceptance criteria&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="14.3%"&gt;Milestone&lt;/td&gt;&lt;td valign="top" width="42.9%"&gt;Scope&lt;/td&gt;&lt;td valign="top" width="42.9%"&gt;Acceptance criteria&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;M0 Walking skeleton (1-2 wk)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;docker-compose; collector -&amp;gt; raw -&amp;gt; validator -&amp;gt; normalizer -&amp;gt; ClickHouse ticks; ClickHouse ingests ticks ONLY via Kafka-engine MV (AvroConfluent; no custom sink scripts); query-api /v1/ticks; dashboard line chart; 1 symbol; CI skeleton + contract checks&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;live tick visible in UI p95 &amp;lt;= 2 s; gap detected, logged, metric emitted; invalid message lands in DLQ. Acceptance rule: unit tests alone never satisfy a milestone; integration evidence is required (testcontainers: Kafka + Schema Registry + ClickHouse).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;M1 Candles &amp;amp; realtime&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Flink candle-aggregator; candles in ClickHouse; realtime-gateway (snapshot + delta); Keycloak + api-gateway; DLQ replay. Proposed milestone assignments (needs maintainer approval): collector.subscriptions + last_seq checkpoint = M1; gap-detector publishing BackfillRequest = M1.&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;tick -&amp;gt; UI p95 &amp;lt;= 500 ms; WS reconnect resumes without gaps; replay 10k DLQ messages without duplicates; gap-detector publishes BackfillRequest to ops.commands.v1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;M2 Platform &amp;amp; observability&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;K8s dev via Argo CD; OTel -&amp;gt; Grafana stack; feature-engine; data-quality; KEDA. Proposed milestone assignments (needs maintainer approval): K8s Lease leader election = M2.&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;SLO dashboards live; chaos: kill broker / Flink TaskManager =&amp;gt; recovery &amp;lt; 2 min, no data loss&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;M3 Lake &amp;amp; batch&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;lake-archiver; historical-ingestor; Spark compaction / backfill; Airflow; candle correction. Proposed milestone assignments (needs maintainer approval): backfill execution = M3.&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;30-day BTC/ETH backfill &amp;lt; 15 min; recomputed candles equal real-time within tolerance (parity test)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;M4 Quant research&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;strategy-core; backtesting; pairs-research; results UI; command-api jobs&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;backtest reproducible (same run_id inputs =&amp;gt; same metrics); pairs report for 20 symbols &amp;lt; 5 min&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;M5 Paper trading&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;strategy-engine, paper-execution, portfolio-service, risk-analytics, kill-switch&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;signal -&amp;gt; position p95 &amp;lt;= 1 s; duplicate signal =&amp;gt; single order; risk breach halts new orders &amp;lt;= 1 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;M6 ML &amp;amp; hardening&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;model-training, MLflow, model-inference, model-monitoring; load test 5k msg/s; DR drill; security review&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;drift alert fires on synthetic shift; model rollback &amp;lt; 5 min; RPO / RTO drill passes&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;" vertex="1" parent="1"><mxGeometry x="30" y="364" width="1900" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>