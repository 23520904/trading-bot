ll><mxCell id="p5_37" value='&lt;b&gt;Legend&lt;/b&gt;&lt;table cellspacing="2" cellpadding="1" style="font-size:10px;"&gt;&lt;tr&gt;&lt;td bgcolor="#dae8fc" style="border:1px solid #6c8ebf;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;Application container (own code)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td bgcolor="#ffe6cc" style="border:1px solid #d79b00;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;Processing engine job (Flink / Spark / Airflow)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td bgcolor="#e1d5e7" style="border:1px solid #9673a6;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;Kafka cluster / topic (pill)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td bgcolor="#d5e8d4" style="border:1px solid #82b366;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;Datastore (cylinder)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px dashed #666666;width:26px;"&gt;&amp;nbsp;&lt;/td&gt;&lt;td&gt;External system (dashed)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="center"&gt;&amp;#9472;&amp;#9472;&amp;#9654;&lt;/td&gt;&lt;td&gt;Synchronous call / connection&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align="center"&gt;&amp;#9480;&amp;#9480;&amp;#9654;&lt;/td&gt;&lt;td&gt;Asynchronous / event via Kafka&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;span style="font-size:10px;color:#555555"&gt;Arrow = data flow; topic names on arrows&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="700" width="330" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d6" name="06 Kafka Topics &amp; Conventions"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2090" pageHeight="841" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6_1" value='&lt;b style="font-size:20px"&gt;Kafka topic catalog &amp;amp; conventions&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#555555"&gt;Contract for all producers/consumers - every arrow in pages 03-05 maps to a row here - Schema Registry: Avro, BACKWARD_TRANSITIVE&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="60" as="geometry"/></mxCell><mxCell id="p6_2" value='&lt;div style="font-size:13px;font-weight:bold;padding:2px 0 4px 0;"&gt;Topic catalog&lt;/div&gt;&lt;table border="1" cellpadding="3" cellspacing="0" style="border-collapse:collapse;border-color:#999999;font-size:10px;width:100%;table-layout:fixed;"&gt;&lt;tr style="background:#dae8fc;font-weight:bold;"&gt;&lt;td valign="top" width="13.8%"&gt;Topic&lt;/td&gt;&lt;td valign="top" width="9.2%"&gt;Key&lt;/td&gt;&lt;td valign="top" width="5.5%"&gt;Partitions&lt;/td&gt;&lt;td valign="top" width="9.2%"&gt;Schema (Avro)&lt;/td&gt;&lt;td valign="top" width="13.8%"&gt;Producer&lt;/td&gt;&lt;td valign="top" width="23.0%"&gt;Consumers (group)&lt;/td&gt;&lt;td valign="top" width="6.9%"&gt;Retention&lt;/td&gt;&lt;td valign="top" width="18.4%"&gt;Notes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market.raw.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;symbol&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;12&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;RawFrame&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market-collector&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;data-validator (cg.data-validator)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;3 d&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;acks=all, idempotent&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market.raw.backfill.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;symbol&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;6&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;RawFrame&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;historical-ingestor, dlq-replayer&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;data-validator (same group)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;7 d&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;low-priority lane; replay target&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market.validated.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;symbol&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;12&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;ValidatedEvent&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;data-validator&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market-normalizer (cg.market-normalizer)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;3 d&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market.normalized.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;symbol&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;12&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;MarketTrade&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market-normalizer&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;candle-aggregator, lake-archiver, data-quality, ClickHouse ticks_queue&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;7 d&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;dedupe key trade_id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market.dlq.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;original key&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;3&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;DeadLetter&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;data-validator, market-normalizer&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;dlq-replayer (cg.dlq-replayer)&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;30 d&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;headers: error_code, error_msg, src_topic, src_partition, src_offset, failed_at&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market.candles.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;symbol|tf&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;12&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;Candle&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;candle-aggregator&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;feature-engine, strategy-engine, realtime-gateway, ClickHouse candles_queue&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;7 d&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;is_final flag; EOS txn&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;market.late.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;symbol&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;3&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;MarketTrade&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;candle-aggregator&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;data-quality&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;3 d&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;beyond allowedLateness&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;features.online.v1&lt;/td&gt;&lt;td valign="top" style="word-wrap:break-word;"&gt;symbol|tf&lt;/td&gt;&lt;td valign="top" style="word-wrap:b