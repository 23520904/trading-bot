{
  "type": "record",
  "name": "ValidatedEvent",
  "namespace": "cip.market",
  "doc": "Validated market event that passed structural and business rules",
  "fields": [
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "schema_version",
      "type": "int",
      "default": 1
    },
    {
      "name": "source",
      "type": "string"
    },
    {
      "name": "symbol",
      "type": "string"
    },
    {
      "name": "event_ts",
      "type": "long"
    },
    {
      "name": "ingest_ts",
      "type": "long"
    },
    {
      "name": "seq",
      "type": "long"
    },
    {
      "name": "channel",
      "type": "string"
    },
    {
      "name": "payload",
      "type": "bytes"
    },
    {
      "name": "ingest_mode",
      "type": {
        "type": "enum",
        "name": "ValidatedIngestMode",
        "symbols": ["live", "backfill", "replay"]
      },
      "default": "live"
    }
  ]
}
